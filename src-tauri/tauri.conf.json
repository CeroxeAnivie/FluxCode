{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxCode",
  "version": "0.1.6",
  "identifier": "dev.fluxcode.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-browser-runtime.mjs && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/prepare-browser-runtime.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "FluxCode",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#121214",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "resources": {
      "resources/engine/": "engine/",
      "resources/legal/": "legal/",
      "resources/browser-runtime/": "browser-runtime/"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
