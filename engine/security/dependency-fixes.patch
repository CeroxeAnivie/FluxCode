+#[cfg(test)]
+mod fluxcode_compression_bounds {
+    use super::*;
+    use crate::serialize::binary::BinDecodable;
+    use crate::rr::Name;
+    #[test]
+    fn name_compression_remains_bounded_and_roundtrips() {
+        let names: Vec<_> = (0..300).map(|i| Name::from_ascii(format!("label{i}.example.test.")).unwrap()).collect();
+        let mut bytes = Vec::new();
+        {
+            let mut encoder = BinEncoder::new(&mut bytes);
+            for name in &names { name.emit(&mut encoder).unwrap(); }
+            assert!(encoder.name_pointers.len() <= 64);
+            assert_eq!(encoder.compressed_name_count, 120);
+        }
+        let mut decoder = crate::serialize::binary::BinDecoder::new(&bytes);
+        for name in names { assert_eq!(Name::read(&mut decoder).unwrap(), name); }
+    }
+}
